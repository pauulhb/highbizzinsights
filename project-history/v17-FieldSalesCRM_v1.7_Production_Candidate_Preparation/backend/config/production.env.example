NODE_ENV=production
PORT=8080
DATABASE_URL=<secret>
JWT_SECRET=<secret>
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_DAYS=30
MIN_QUALIFIED_VISIT_SECONDS=900
DEFAULT_GEOFENCE_METERS=200
STORAGE_PROVIDER=s3-compatible
STORAGE_BUCKET=<bucket>
STORAGE_REGION=<region>
NOTIFICATION_PROVIDER=<provider>
PUSH_PROVIDER_KEY=<secret>
PDF_PROVIDER=<provider>
PDF_SERVICE_URL=<url>
LOG_LEVEL=info
